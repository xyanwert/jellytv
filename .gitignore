# ---- Xcode / build products ----
# The .xcodeproj is generated from project.yml by XcodeGen — never commit it.
*.xcodeproj
DerivedData/
build/
*.xcarchive
*.ipa
*.dSYM.zip
*.dSYM

# XcodeGen-generated Info.plist files (source of truth is project.yml)
Apps/*/Support/Info.plist

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# XcodeBuildMCP session defaults — an absolute project path + a simulator
# UDID, neither of which means anything on another machine.
.xcodebuildmcp/

# ---- Swift Package Manager ----
.build/
.swiftpm/
Packages/*/.build/

# ---- macOS ----
.DS_Store

# ---- Claude Code (user-local settings) ----
.claude/settings.local.json

# ---- Secrets / signing (NEVER commit) ----
fastlane/.env
fastlane/*.env
*.p8
*.p12
*.mobileprovision
*.cer
AuthKey_*.p8

# TMDB key for the dev-only MockCatalogGenerator tool — never commit
Packages/JellyTVKit/.env.local

# ---- fastlane ----
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
fastlane/README.md

# ---- design canvases ----
# Each Design/<screen>/ folder keeps the sources of a design canvas: the
# .dc.html artboards, canvas.json and the artwork they reference. The seeded
# page beside them bundles a ~2.7 MB copy of the canvas editor and is rebuilt
# from those sources, so it stays out of history.
Design/*/*.html
!Design/*/*.dc.html
